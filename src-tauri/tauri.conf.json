{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DS Software",
  "version": "0.1.0",
  "identifier": "com.antigravity.pos",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 8081 --strictPort",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:8081",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DS Software",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
